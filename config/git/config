[user]
	name = Sam J
	email = samjojames@gmail.com

[alias]
	co = checkout
	cm = commit -m
	fp = !git fetch --prune && git reset --hard @{u}
	w = worktree
	wl = worktree list
	wc = !git-wt-cd
	wf = "!f() { git worktree add -b \"$1\" ../\"$1\" main; }; f"

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	editor = nvim
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

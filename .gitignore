# Secrets - never commit these
shell/env.zsh

# macOS
.DS_Store

# Editor
*.swp
*.swo
*~

# Backup files created by symlinks script
*.backup

# OpenCode runtime files
config/opencode/node_modules/

# Claude runtime files (created when Claude runs)
config/claude/history.jsonl
config/claude/projects/
config/claude/debug/
